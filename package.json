{
  "name": "code-dungeon",
  "version": "0.1.0",
  "private": true,
  "description": "Code Dungeon — a learning platform experienced as an illustrated fantasy game world.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:verify-python": "tsx scripts/verify-python-examples.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run content:validate && npm run content:verify-python && npm run build",
    "db:local": "bash scripts/db/local-postgres.sh",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:status": "tsx scripts/db/migrate.ts --status",
    "content:release-check": "tsx scripts/content-release-check.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/alegreya-sans": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.4.1",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "playwright-core": "1.56.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
