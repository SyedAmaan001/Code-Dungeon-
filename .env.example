# Python interpreter used by `npm run content:verify-python` (optional; defaults to python3).
PYTHON=

# --- Local PostgreSQL (Phase 4). `npm run db:local -- start` prints values for a local cluster.
# Put real values in .env.local (git-ignored). Server-only: never expose these to the browser.
DATABASE_URL=
# Admin connection used by the database tests to create throwaway databases (local/CI only).
TEST_DATABASE_URL=
# Set to 1 to make database tests fail instead of skip when TEST_DATABASE_URL is missing (CI does).
REQUIRE_DB_TESTS=

# Optional: maximum PostgreSQL connections per server process (default 5).
DATABASE_POOL_MAX=

# --- Sign-in (Phase 5; docs/auth-design.md, DEC-009) ---
# supabase | dev | (empty = sign-in disabled)
AUTH_MODE=
# AUTH_MODE=dev only: development sign-in for local play and tests. Refused in production builds.
# Generate locally with `openssl rand -hex 32`; at least 32 characters.
DEV_AUTH_SECRET=
# AUTH_MODE=supabase only. NOT YET PROVISIONED: the Supabase project and keys need owner approval.
# Only the publishable key may reach the browser; never put a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public origin used for OAuth and magic-link redirects (https in production), e.g. http://localhost:3000
APP_URL=

# --- Content release (DEC-011): development (default, all levels) | public (human-reviewed only)
CONTENT_RELEASE=
