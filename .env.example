# Python interpreter used by `npm run content:verify-python` (optional; defaults to python3).
PYTHON=

# --- Local PostgreSQL (Phase 4). `npm run db:local -- start` prints values for a local cluster.
# Put real values in .env.local (git-ignored). Server-only: never expose these to the browser.
DATABASE_URL=
# Admin connection used by the database tests to create throwaway databases (local/CI only).
TEST_DATABASE_URL=
# Set to 1 to make database tests fail instead of skip when TEST_DATABASE_URL is missing (CI does).
REQUIRE_DB_TESTS=

# --- Not yet provisioned (needs an owner-approved provider and cost plan; docs/auth-design.md). ---
# AUTH_PROVIDER_URL=
# AUTH_PROVIDER_PUBLISHABLE_KEY=
